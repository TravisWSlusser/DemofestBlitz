<?xml version="1.0" encoding="UTF-8"?>
<!-- Side-Qlik Pre-Show: a PowerPoint content add-in that shows the live pre-show page on a slide.
     Sideloaded on Travis's laptop (registry: HKCU\Software\Microsoft\Office\16.0\WEF\Developer). No store, no admin. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>fbd0079d-f25e-455a-bd50-96bfcc9e93dd</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Travis Slusser</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Side-Qlik Pre-Show"/>
  <Description DefaultValue="Live pre-show from the Stellar-Seller universe, running inside the slide."/>
  <IconUrl DefaultValue="https://demofest-blitz.vercel.app/assets/brand/addin32.png"/>
  <HighResolutionIconUrl DefaultValue="https://demofest-blitz.vercel.app/assets/brand/addin64.png"/>
  <SupportUrl DefaultValue="https://www.linkedin.com/in/travis-slusser/"/>
  <AppDomains>
    <AppDomain>https://demofest-blitz.vercel.app</AppDomain>
    <AppDomain>https://www.youtube-nocookie.com</AppDomain>
    <AppDomain>https://fonts.googleapis.com</AppDomain>
    <AppDomain>https://fonts.gstatic.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://demofest-blitz.vercel.app/slide.html"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
</OfficeApp>
