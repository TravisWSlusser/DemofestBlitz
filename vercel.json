{
  "rewrites": [
    { "source": "/api/blitz/:action", "destination": "/api/blitz?action=:action" },
    { "source": "/api/preshow/:action", "destination": "/api/preshow?action=:action" },
    { "source": "/visit", "destination": "/visit.html" },
    { "source": "/609", "destination": "/join.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
